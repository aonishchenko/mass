{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mass",
  "main": "src/index.ts",
  // Pinned so a multi-account login cannot deploy to the wrong place.
  "account_id": "3550b1d16b78241182c4cb602b695110",
  "workers_dev": true,
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],

  "assets": { "directory": "./web/dist", "binding": "ASSETS" },

  "vars": {
    // Non-secret config. Secrets (ZG_ROUTER_KEY, ZG_PRIVATE_KEY, SESSION_KEY)
    // go in .dev.vars locally and `wrangler secret put` in prod.
    "ZG_ROUTER_URL": "https://router-api-testnet.integratenetwork.work/v1",
    // Verified 2026-07-25: qwen2.5-omni is the ONLY chatbot model on testnet
    // (tee_attested, TeeTLS, ctx 32768). Measured 23.7 tok/s streaming.
    // Mainnet has more (MiniMax-M3, GLM-5.1) — re-check /v1/models if switching.
    "ZG_DRAFT_MODEL": "qwen2.5-omni",
    "ZG_CANONICAL_MODEL": "qwen2.5-omni",
    "ZG_STORAGE_RPC": "https://evmrpc-testnet.0g.ai",
    "ZG_STORAGE_INDEXER": "https://indexer-storage-testnet-turbo.0g.ai",

    // World (M3) — server-side proof verification. See docs/WORLD-SETUP.md.
    // app_id + rp_id are filled once the Developer Portal app exists. Blank keeps
    // verification "not configured" (the UI says so). WORLD_RP_PRIVATE_KEY is a
    // SECRET (wrangler secret put), as is WORLD_DEV_FALLBACK if used for rehearsal.
    // Public values. worldConfigured() requires BOTH, so real verification stays
    // off until WORLD_RP_ID is filled too.
    "WORLD_APP_ID": "app_95c2252f501bcd906cea4fcab43ba5cd",
    "WORLD_RP_ID": "rp_6374dd7eeced874f",
    // production => the real World App verifies. staging => the simulator at
    // simulator.worldcoin.org. The client reads this value from
    // /api/verify/context, so both halves always agree.
    "WORLD_ENV": "production",
    "WORLD_ACTION_SELFIE": "mass-selfie",
    "WORLD_ACTION_AGENTKIT": "mass-agentkit",
    "WORLD_SYBIL_THRESHOLD": "0.5",

    // ENS (M5) — identity & careers. See docs/ENS-TASK.md. ENS_PARENT_NAME +
    // ENS_L1_RPC enable live resolution; blank runs the deterministic dev names.
    "ENS_PARENT_NAME": "",
    "ENS_AGENT_LABEL": "docs",
    "ENS_CHAIN": "mainnet"
  }
}
